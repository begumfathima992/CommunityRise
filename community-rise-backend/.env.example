# --- Runtime -----------------------------------------------------------
NODE_ENV=development
PORT=5001
# Optional: fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info

# --- Database (PostgreSQL) --------------------------------------------
# Production connects with SSL. Optional production SSL settings:
#   DB_SSL_CA_PATH=/path/to/ca-bundle.pem
#   DB_SSL_REJECT_UNAUTHORIZED=false   (only if you cannot supply a CA)
DATABASE_URL=postgres://ziggy@localhost:5432/communityrise
# Used by `npm test` and NODE_ENV=test (defaults to the value below)
TEST_DATABASE_URL=postgres://ziggy@localhost:5432/communityrise_test

# --- Auth --------------------------------------------------------------
# Two different random values, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# Frontend origin(s), comma-separated. Used for CORS and email links
# (links use the first one).
CLIENT_URL=http://localhost:5173
# Production example (first origin is used for links in emails):
# CLIENT_URL=https://communityrise.uk,https://www.communityrise.uk

# Path the refresh_token cookie is scoped to. Must match the path the
# browser uses to reach /api/v1/auth (e.g. /communityrise-api/v1/auth
# behind the Nginx prefix).
REFRESH_COOKIE_PATH=/api/v1/auth

# --- Email (Resend HTTPS API) ----------------------------------------
# Sent over HTTPS, so it works on hosts that block SMTP (e.g. Render free).
# Create an API key at https://resend.com/api-keys (sending access only).
# If these are missing the server still starts, but emails fail to send.
RESEND_API_KEY=replace-with-your-resend-api-key
# Sender. Must use a domain verified in Resend.
MAIL_FROM="Community Rise <noreply@communityrise.uk>"
# Inbox that receives contact form, free place and tutor application emails.
CONTACT_RECIPIENT=help@communityrise.uk
# Optional: only for pointing at a mock server in local testing.
# RESEND_API_URL=https://api.resend.com

# --- Admin seeder (npm run db:seed) -----------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# ADMIN_FULL_NAME=Community Rise Admin
