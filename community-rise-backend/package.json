{
  "name": "community-rise-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:create": "sequelize-cli --options-path .sequelizerc.cjs db:create",
    "db:migrate": "sequelize-cli --options-path .sequelizerc.cjs db:migrate",
    "db:migrate:undo": "sequelize-cli --options-path .sequelizerc.cjs db:migrate:undo",
    "db:migrate:status": "sequelize-cli --options-path .sequelizerc.cjs db:migrate:status",
    "db:seed": "sequelize-cli --options-path .sequelizerc.cjs db:seed:all",
    "db:seed:undo": "sequelize-cli --options-path .sequelizerc.cjs db:seed:undo:all",
    "db:test:create": "NODE_ENV=test sequelize-cli --options-path .sequelizerc.cjs db:create",
    "db:test:migrate": "NODE_ENV=test sequelize-cli --options-path .sequelizerc.cjs db:migrate",
    "pretest": "npm run db:test:migrate",
    "test": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sequelize": "^6.37.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.1"
  },
  "description": "Community Rise backend: contact form and authentication API",
  "engines": {
    "node": "24.x"
  }
}
